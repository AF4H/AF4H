ENABLE_SER2NET=true
ENABLE_RADIO_AUDIO=true
ENABLE_RADIO_AUDIO_STREAMER=true
ENABLE_NETWORK_RADIO_DASHBOARD=true
ENABLE_USBIPD=true
ENABLE_USBIP_BIND=true
ENABLE_USBIP_ATTACH=true
ENABLE_USBIP_WATCHDOG=true
INSTALL_ROOT=/opt/network-radio-server
AUDIO_BRIDGE_ENABLED=true
AUDIO_BRIDGE_MODE=placeholder
AUDIO_BRIDGE_LOGGER_TAG=radio-audio
AUDIO_STREAMER_ENABLED=true
AUDIO_STREAMER_LOGGER_TAG=WWH23-feed
SAME_ENABLED=true
SAME_WATCH_TAG=same-watch
SAME_ACTION_TAG=same-act
