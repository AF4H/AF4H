# Example ser2net configuration for AF4H radio and serial ports.
# Generated from `config.yaml` via `render-config.py`.
# Edit the manifest, then regenerate this file so the docs and config stay in lockstep.

connection: &port_7301
  accepter: tcp,7301
  connector: serialdev,/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0,115200 8n1,local
  options:
    kickolduser: true
  # local console or radio serial

connection: &port_7302
  accepter: tcp,7302
  connector: serialdev,/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AR0KHLQA-if00-port0,115200 8n1,local
  options:
    kickolduser: true
  # local console or radio serial

connection: &port_7303
  accepter: tcp,7303
  connector: serialdev,/dev/serial/by-id/usb-Prolific_Technology_Inc._USB-Serial_Controller-if00-port0,115200 8n1,local
  options:
    kickolduser: true
  # local console or radio serial

connection: &port_7304
  accepter: tcp,7304
  connector: serialdev,/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_IC-7100_02015445_A-if00-port0,19200 8n1,local
  options:
    kickolduser: true
  # IC-7100 CAT

connection: &port_7305
  accepter: tcp,7305
  connector: serialdev,/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_IC-7100_02015445_B-if00-port0,19200 8n1,local
  options:
    kickolduser: true
  # IC-7100 CAT

connection: &port_7310
  accepter: tcp,7310
  connector: serialdev,/dev/serial/by-id/usb-Prolific_Technology_Inc._USB-Serial_Controller_D-if00-port0,115200 8n1,local
  options:
    kickolduser: true
  # router or infrastructure console
